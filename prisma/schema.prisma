// Prisma Schema for Alpha Watch & Opticals eCommerce & Admin Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Setting {
  id               String   @id @default("global_settings")
  globalTheme      String   @default("obsidian") // "obsidian" | "midnight" | "oxblood" | "emerald" | "platinum"
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  phone           String?
  passwordHash    String?
  role            String      @default("customer") // "customer" | "admin"
  provider        String      @default("credentials") // "credentials" | "google"
  avatar          String?
  blocked         Boolean     @default(false)
  themePreference String?     // nullable: null = follow store default, or "obsidian" | "midnight" | "oxblood" | "emerald" | "platinum"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String   @default("Raebareli")
  state     String   @default("Uttar Pradesh")
  pincode   String   @default("229001")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  sku          String    @unique
  brand        String
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  price        Float
  mrp          Float
  stock        Int       @default(0)
  status       String    @default("published") // "published" | "draft"
  description  String
  specsJson    String    @default("{}")
  imagesJson   String    @default("[]")
  badgesJson   String    @default("[]")
  rating       Float     @default(5.0)
  reviewsCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  variants     Variant[]
  reviews      Review[]
  orderItems   OrderItem[]
}

model Variant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantType String   // "Strap" | "Lens" | "Power" | "Color"
  value       String
  stock       Int      @default(0)
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  rating    Int      @default(5)
  title     String
  comment   String
  status    String   @default("approved") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("percent") // "percent" | "fixed"
  value       Float
  minCart     Float     @default(0)
  maxDiscount Float?
  expiresAt   DateTime?
  usageLimit  Int       @default(100)
  used        Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail         String
  userName          String
  userPhone         String
  status            String      @default("pending") // "pending" | "confirmed" | "packed" | "ready_for_pickup" | "dispatched" | "delivered" | "cancelled"
  paymentStatus     String      @default("pending") // "pending" | "paid" | "failed"
  deliveryMethod    String      @default("pickup")  // "pickup" | "delivery"
  subtotal          Float
  discount          Float       @default(0)
  shipping          Float       @default(0)
  total             Float
  couponCode        String?
  shippingAddress   String?     // JSON string of address
  razorpayOrderId   String?
  razorpayPaymentId String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  image     String
  variant   String?
  price     Float
  quantity  Int
  total     Float
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  status    String   @default("new") // "new" | "read" | "replied"
  createdAt DateTime @default(now())
}

model Appointment {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  serviceType   String   @default("Eye Test")
  preferredDate String
  status        String   @default("pending") // "pending" | "confirmed" | "completed"
  createdAt     DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
